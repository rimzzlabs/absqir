---
import { translatorFor } from "@absqir/i18n";
import { NotificationsPage } from "@/components/notifications/notifications-page";
import DashboardLayout from "@/layouts/dashboard-layout.astro";

const { activeMembership } = Astro.locals;

if (!activeMembership) return Astro.redirect("/", 302);

const t = translatorFor(Astro.locals.locale);
---

<DashboardLayout title={t("shell:titles.notifications")}>
  <NotificationsPage client:load locale={Astro.locals.locale} orgSlug={activeMembership.slug} />
</DashboardLayout>
