---
import { translatorFor } from "@absqir/i18n";
import { OrganizationSettingsPage } from "@/components/organization/organization-settings-page";
import DashboardLayout from "@/layouts/dashboard-layout.astro";

// Only an owner or an admin runs the organization. Everybody else lands on
// their own settings, which is the nearest page they can use.
const { activeMembership } = Astro.locals;

if (!activeMembership) return Astro.redirect("/", 302);

const role = activeMembership.role;

if (role !== "owner" && role !== "admin") {
  return Astro.redirect("/settings", 302);
}

const t = translatorFor(Astro.locals.locale);
---

<DashboardLayout title={t("shell:titles.organization")}>
  <OrganizationSettingsPage
    client:load
    locale={Astro.locals.locale}
    orgSlug={activeMembership.slug}
    role={role}
    organization={{
      id: activeMembership.organizationId,
      name: activeMembership.name,
      slug: activeMembership.slug,
    }}
    requestedTab={Astro.url.searchParams.get("tab")}
  />
</DashboardLayout>
