---
import { SessionsPage } from "@/components/sessions/sessions-page";
import DashboardLayout from "@/layouts/dashboard-layout.astro";

const role = Astro.locals.activeMembership?.role ?? "member";

if (role === "member") {
  return Astro.redirect("/my/sessions", 302);
}
---

<DashboardLayout title="Events">
  <SessionsPage client:load role={role} />
</DashboardLayout>
