---
import { buttonVariants } from "@absqir/ui/button";
import Layout from "@/layouts/layout.astro";

interface Props {
  error: unknown;
}

const { error } = Astro.props;

// The reader only sees the generic screen; the Worker log keeps the cause.
console.error("Unhandled render error:", error);

// A link back to the failing URL retries the request without client JS.
const retryHref = Astro.url.pathname + Astro.url.search;
---

<Layout title="Something went wrong">
  <main class="mx-auto flex min-h-dvh max-w-sm flex-col justify-center px-6 py-16">
    <p class="text-muted-foreground font-mono text-sm">500</p>
    <h1 class="mt-2 font-serif text-3xl font-bold tracking-tight">Something went wrong</h1>
    <p class="text-muted-foreground mt-1 mb-8 text-sm">
      The server could not finish your request. The problem is on our side. Try again in a moment.
    </p>
    <div class="flex items-center gap-3">
      <a href={retryHref} class={buttonVariants({ variant: "default" })}>Try again</a>
      <a href="/" class={buttonVariants({ variant: "outline" })}>Go to the home page</a>
    </div>
  </main>
</Layout>
