---
import { EmptyModule } from "@/components/shared/empty-module";
import DashboardLayout from "@/layouts/dashboard-layout.astro";

const role = Astro.locals.activeMembership?.role ?? "member";

if (role === "member") {
  return Astro.redirect("/my/sessions", 302);
}
---

<DashboardLayout title="Reports">
  <EmptyModule
    icon="reports"
    title="Reports"
    description="Who showed up, how often, and how late, per person, per group, per period."
    phase={4}
    bullets={[
      "Attendance rate per person and per group over a chosen range.",
      "The chronic latecomers and the never-absent, at a glance.",
      "CSV export of every table, for the spreadsheet people.",
    ]}
  />
</DashboardLayout>
