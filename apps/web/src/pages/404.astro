---
import { buttonVariants } from "@absqir/ui/button";
import Layout from "@/layouts/layout.astro";
---

<Layout title="Page not found">
  <main class="mx-auto flex min-h-dvh max-w-sm flex-col justify-center px-6 py-16">
    <p class="text-muted-foreground font-mono text-sm">404</p>
    <h1 class="mt-2 font-serif text-3xl font-bold tracking-tight">Page not found</h1>
    <p class="text-muted-foreground mt-1 mb-8 text-sm">
      This page does not exist. The address can be wrong, or the page moved.
    </p>
    <div class="flex items-center gap-3">
      <a href="/" class={buttonVariants({ variant: "default" })}>Go to the home page</a>
    </div>
  </main>
</Layout>
