---
import { EmptyModule } from "@/components/shared/empty-module";
import DashboardLayout from "@/layouts/dashboard-layout.astro";

const role = Astro.locals.activeMembership?.role ?? "member";

if (role === "member") {
  return Astro.redirect("/my/sessions", 302);
}
---

<DashboardLayout title="Calendar">
  <EmptyModule
    icon="calendar"
    title="Calendar"
    description="Every session on a month and a week view, with the schedules that generate them."
    phase={4}
    bullets={[
      "Month and week views across all groups.",
      "Click a day to create a session there.",
      "Public holidays and closures, so a schedule skips them.",
    ]}
  />
</DashboardLayout>
