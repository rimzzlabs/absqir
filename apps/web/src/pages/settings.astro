---
import { isNotificationChannel } from "@absqir/core/notification-channel";
import { SettingsPage } from "@/components/settings/settings-page";
import DashboardLayout from "@/layouts/dashboard-layout.astro";

// Everyone has an account and preferences here. The organization tabs show
// for owners and admins only; the page decides from the role.
const { user, activeMembership } = Astro.locals;

if (!user || !activeMembership) {
  return Astro.redirect("/", 302);
}

const organization = {
  id: activeMembership.organizationId,
  name: activeMembership.name,
  slug: activeMembership.slug,
};

const shellUser = {
  name: user.name,
  email: user.email,
  image: user.image ?? null,
  createdAt: new Date(user.createdAt).toISOString(),
  notificationChannel: isNotificationChannel(user.notificationChannel)
    ? user.notificationChannel
    : "all",
  timezone: user.timezone ?? null,
};
---

<DashboardLayout title="Settings">
  <SettingsPage
    client:load
    role={activeMembership.role}
    organization={organization}
    currentUserId={user.id}
    user={shellUser}
    requestedTab={Astro.url.searchParams.get("tab")}
  />
</DashboardLayout>
