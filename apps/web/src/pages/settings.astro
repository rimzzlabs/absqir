---
import { isNotificationChannel } from "@absqir/core/notification-channel";
import { orgPath } from "@absqir/core/org-path";
import { translatorFor } from "@absqir/i18n";
import { match, P } from "ts-pattern";
import { SettingsPage } from "@/components/settings/settings-page";
import DashboardLayout from "@/layouts/dashboard-layout.astro";

// Settings holds the account only. The organization moved to its own menu,
// so a link that names one of its old tabs lands there instead.
const { user, activeMembership } = Astro.locals;

if (!user) {
  return Astro.redirect("/sign-in", 302);
}

const ORGANIZATION_TABS: Record<string, string> = {
  members: "/organization/members",
  invitations: "/organization/members",
  requests: "/organization/members",
  places: "/organization?tab=places",
  domains: "/organization?tab=domains",
  organization: "/organization",
};

const role = activeMembership?.role ?? null;
const runsOrganization = role === "owner" || role === "admin";
const requestedTab = Astro.url.searchParams.get("tab");
const moved = ORGANIZATION_TABS[requestedTab ?? ""];

if (runsOrganization && moved && activeMembership) {
  return Astro.redirect(orgPath(activeMembership.slug, moved), 302);
}

// An account with no organization still owns a profile, preferences, and a
// list of its devices.
const organization = match(activeMembership)
  .with(P.nullish, () => null)
  .otherwise((activeMembership) => ({
    id: activeMembership.organizationId,
    name: activeMembership.name,
    slug: activeMembership.slug,
  }));

const shellUser = {
  name: user.name,
  email: user.email,
  image: user.image ?? null,
  createdAt: new Date(user.createdAt).toISOString(),
  notificationChannel: match(user.notificationChannel)
    .with(P.when(isNotificationChannel), (channel) => channel)
    .otherwise(() => "all" as const),
  timezone: user.timezone ?? null,
};
const t = translatorFor(Astro.locals.locale);
---

<DashboardLayout title={t("shell:titles.settings")}>
  <SettingsPage
    client:load
    locale={Astro.locals.locale}
    role={role}
    organization={organization}
    user={shellUser}
    requestedTab={requestedTab}
  />
</DashboardLayout>
