---
import { SessionDetail } from "@/components/sessions/session-detail";
import DashboardLayout from "@/layouts/dashboard-layout.astro";

const { id } = Astro.params;
const role = Astro.locals.activeMembership?.role ?? "member";

if (!id) {
  return Astro.redirect("/sessions", 302);
}

if (role === "member") {
  return Astro.redirect("/my/sessions", 302);
}
---

<DashboardLayout title="Event">
  <SessionDetail client:load sessionId={id} role={role} />
</DashboardLayout>
