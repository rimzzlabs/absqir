---
import { Scanner } from "@/components/sessions/scanner";
import Layout from "@/layouts/layout.astro";

const { id } = Astro.params;
const role = Astro.locals.activeMembership?.role ?? "member";

if (!id) {
  return Astro.redirect("/sessions", 302);
}

if (role === "member") {
  return Astro.redirect("/my/sessions", 302);
}
---

<Layout title="Scanner — absqir">
  <Scanner client:load sessionId={id} />
</Layout>
