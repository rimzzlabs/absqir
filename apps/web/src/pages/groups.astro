---
import { translatorFor } from "@absqir/i18n";
import { GroupsPage } from "@/components/groups/groups-page";
import DashboardLayout from "@/layouts/dashboard-layout.astro";

const role = Astro.locals.activeMembership?.role ?? "member";

if (role === "member") {
  return Astro.redirect("/my/events", 302);
}
const t = translatorFor(Astro.locals.locale);
---

<DashboardLayout title={t("shell:titles.groups")}>
  <GroupsPage client:load locale={Astro.locals.locale} role={role} />
</DashboardLayout>
