---
import { AuthFlow } from "@/components/auth/auth-flow";
import AuthLayout from "@/layouts/auth-layout.astro";

const next = Astro.url.searchParams.get("next") ?? "/";
// Only a path from this site, never an absolute URL a stranger supplied.
const safeNext = next.startsWith("/") && !next.startsWith("//") ? next : "/";
const email = Astro.url.searchParams.get("email") ?? "";
---

<AuthLayout title="Sign in — absqir">
  <AuthFlow client:load next={safeNext} initialEmail={email} />
</AuthLayout>
