---
import { enabledSocialProviders } from "@absqir/api";
import { getRuntime } from "@app-runtime";
import { match, P } from "ts-pattern";
import { AuthFlow } from "@/components/auth/auth-flow";
import AuthLayout from "@/layouts/auth-layout.astro";
import { isAuthProvider, readCallbackError } from "@/lib/auth-providers";
import { setEventCookie } from "@/lib/event-cookie";

const next = Astro.url.searchParams.get("next") ?? "/";
// Only a path from this site, never an absolute URL a stranger supplied.
const safeNext = match(next)
  .with(P.string.startsWith("//"), () => "/")
  .with(P.string.startsWith("/"), (path) => path)
  .otherwise(() => "/");
const email = Astro.url.searchParams.get("email") ?? "";
// The public event page sends its id along, so a stranger can create an
// account through it. The cookie is what the sign-up door checks.
const eventId = Astro.url.searchParams.get("event");

if (eventId) {
  setEventCookie(Astro.cookies, eventId);
}

// Which buttons the card shows is a server fact: the keys the operator set.
// Reading it here keeps the row on the first paint, before any request.
const providers = enabledSocialProviders(getRuntime(Astro.locals).bindings);

// A provider that refused sends the reader back here. The page owns the
// wording, so only the code and a checked address survive the address bar.
const provider = Astro.url.searchParams.get("provider") ?? "";
const callbackError = readCallbackError({
  code: Astro.url.searchParams.get("error"),
  description: Astro.url.searchParams.get("error_description"),
  provider: match(provider)
    .with(P.when(isAuthProvider), (name) => name)
    .otherwise(() => null),
});
---

<AuthLayout title="Sign in — absqir">
  <AuthFlow
    client:load
    next={safeNext}
    initialEmail={email}
    eventId={eventId}
    providers={providers}
    callbackError={callbackError}
  />
</AuthLayout>
