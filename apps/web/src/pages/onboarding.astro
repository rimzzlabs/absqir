---
import { translatorFor } from "@absqir/i18n";
import { OnboardingFlow } from "@/components/onboarding/onboarding-flow";
import AuthLayout from "@/layouts/auth-layout.astro";

const invitationId = Astro.url.searchParams.get("invitation");
const eventId = Astro.url.searchParams.get("event");
const t = translatorFor(Astro.locals.locale);
---

<AuthLayout title={`${t("onboarding:pageTitle")} — absqir`}>
  <OnboardingFlow
    client:load
    locale={Astro.locals.locale}
    invitationId={invitationId}
    eventId={eventId}
  />
</AuthLayout>
