---
import { EventDetail } from "@/components/events/event-detail";
import DashboardLayout from "@/layouts/dashboard-layout.astro";

const { id } = Astro.params;
const role = Astro.locals.activeMembership?.role ?? "member";

if (!id) {
  return Astro.redirect("/events", 302);
}

if (role === "member") {
  return Astro.redirect("/my/events", 302);
}
---

<DashboardLayout title="Event">
  <EventDetail client:load eventId={id} role={role} />
</DashboardLayout>
