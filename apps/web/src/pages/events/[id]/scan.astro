---
import { translatorFor } from "@absqir/i18n";
import { Scanner } from "@/components/events/scanner";
import Layout from "@/layouts/layout.astro";

const { id } = Astro.params;
const role = Astro.locals.activeMembership?.role ?? "member";

if (!id) {
  return Astro.redirect("/events", 302);
}

if (role === "member") {
  return Astro.redirect("/my/events", 302);
}
const t = translatorFor(Astro.locals.locale);
---

<Layout title={`${t("shell:titles.scan")} — absqir`}>
  <Scanner client:load locale={Astro.locals.locale} eventId={id} />
</Layout>
