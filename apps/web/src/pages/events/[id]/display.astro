---
import { translatorFor } from "@absqir/i18n";
import { QrDisplay } from "@/components/events/qr-display";
import Layout from "@/layouts/layout.astro";

const { id } = Astro.params;
const role = Astro.locals.activeMembership?.role ?? "member";

if (!id) {
  return Astro.redirect("/events", 302);
}

if (role === "member") {
  return Astro.redirect("/my/events", 302);
}
const t = translatorFor(Astro.locals.locale);
---

<Layout title={`${t("shell:titles.display")} — absqir`}>
  <QrDisplay client:load locale={Astro.locals.locale} eventId={id} />
</Layout>
