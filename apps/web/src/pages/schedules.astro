---
import { SchedulesPage } from "@/components/schedules/schedules-page";
import DashboardLayout from "@/layouts/dashboard-layout.astro";

const role = Astro.locals.activeMembership?.role ?? "member";

if (role === "member") {
  return Astro.redirect("/my/sessions", 302);
}
---

<DashboardLayout title="Schedules">
  <SchedulesPage client:load role={role} />
</DashboardLayout>
