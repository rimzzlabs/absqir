---
import { PeoplePage } from "@/components/people/people-page";
import DashboardLayout from "@/layouts/dashboard-layout.astro";

const role = Astro.locals.activeMembership?.role ?? "member";
const currentUserId = Astro.locals.user?.id ?? null;

if (role === "member") {
  return Astro.redirect("/my/events", 302);
}
---

<DashboardLayout title="People">
  <PeoplePage client:load role={role} currentUserId={currentUserId} />
</DashboardLayout>
