---
import { translatorFor } from "@absqir/i18n";
import { LeavePage } from "@/components/leave/leave-page";
import DashboardLayout from "@/layouts/dashboard-layout.astro";

const role = Astro.locals.activeMembership?.role ?? "member";

if (role === "member") {
  return Astro.redirect("/my/leave", 302);
}
const t = translatorFor(Astro.locals.locale);
---

<DashboardLayout title={t("shell:titles.leave")}>
  <LeavePage client:load locale={Astro.locals.locale} />
</DashboardLayout>
