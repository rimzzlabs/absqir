---
import { CheckInReportsPage } from "@/components/check-in-reports/check-in-reports-page";
import DashboardLayout from "@/layouts/dashboard-layout.astro";

const role = Astro.locals.activeMembership?.role ?? "member";

if (role === "member") {
  return Astro.redirect("/my/events", 302);
}
---

<DashboardLayout title="Check-in problems">
  <CheckInReportsPage client:load locale={Astro.locals.locale} />
</DashboardLayout>
