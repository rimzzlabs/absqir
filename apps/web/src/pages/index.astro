---
import { GettingStartedPage } from "@/components/home/getting-started-page";
import { HomePage } from "@/components/home/home-page";
import { MemberHomePage } from "@/components/home/member-home-page";
import DashboardLayout from "@/layouts/dashboard-layout.astro";

const { user, activeMembership } = Astro.locals;
const isMember = activeMembership?.role === "member";
---

<DashboardLayout title={activeMembership ? "Home" : "Getting started"}>
  {
    !activeMembership ? (
      <GettingStartedPage client:load userName={user?.name ?? ""} />
    ) : isMember ? (
      <MemberHomePage
        client:load
        userName={user?.name ?? ""}
        organizationName={activeMembership.name}
        timezone={user?.timezone ?? null}
      />
    ) : (
      <HomePage client:load userName={user?.name ?? ""} userEmail={user?.email ?? ""} />
    )
  }
</DashboardLayout>
