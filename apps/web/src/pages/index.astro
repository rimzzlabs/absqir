---
import { HomePage } from "@/components/home/home-page";
import { MemberHomePage } from "@/components/home/member-home-page";
import DashboardLayout from "@/layouts/dashboard-layout.astro";

const { user, activeMembership } = Astro.locals;
const isMember = activeMembership?.role === "member";
---

<DashboardLayout title="Home">
  {
    isMember ? (
      <MemberHomePage client:load userName={user?.name ?? ""} />
    ) : (
      <HomePage client:load userName={user?.name ?? ""} />
    )
  }
</DashboardLayout>
