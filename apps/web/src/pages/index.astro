---
import { GettingStartedPage } from "@/components/home/getting-started-page";
import DashboardLayout from "@/layouts/dashboard-layout.astro";

// The door for an account that belongs to no organization yet. A reader who
// has one never reaches this page: the middleware sends the browser to the
// address of that organization instead.
const { user } = Astro.locals;
---

<DashboardLayout title="Getting started">
  <GettingStartedPage client:load locale={Astro.locals.locale} userName={user?.name ?? ""} />
</DashboardLayout>
