---
import { AppShell } from "@/components/app-shell/app-shell";
import Layout from "@/layouts/layout.astro";

interface Props {
  title: string;
}

const { title } = Astro.props;

// src/middleware.ts already redirected a signed-out reader and an unfinished
// account. An account with no organization reaches the home page, where the
// frame renders with the navigation locked.
const { user, memberships, activeMembership } = Astro.locals;

if (!user) {
  return Astro.redirect("/sign-in", 302);
}

// The sidebar writes its state to a cookie on every toggle. Reading it here
// lets the server paint the sidebar the way the reader left it.
const sidebarOpen = Astro.cookies.get("sidebar_state")?.value !== "false";

const shellUser = {
  name: user.name,
  email: user.email,
  image: user.image ?? null,
  canCreateOrganizations: user.canCreateOrganizations === true,
};
---

<Layout
  title={activeMembership ? `${title} — ${activeMembership.name} — absqir` : `${title} — absqir`}
  timezone={user.timezone ?? null}
>
  <AppShell
    client:load
    user={shellUser}
    memberships={memberships}
    active={activeMembership}
    currentPath={Astro.url.pathname}
    title={title}
    sidebarOpen={sidebarOpen}
  >
    <slot />
  </AppShell>
</Layout>
