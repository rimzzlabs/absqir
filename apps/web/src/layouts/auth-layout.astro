---
import Layout from "@/layouts/layout.astro";

interface Props {
  title: string;
  heading: string;
  subheading: string;
}

const { title, heading, subheading } = Astro.props;
---

<Layout title={title}>
  <main class="mx-auto flex min-h-dvh max-w-sm flex-col justify-center px-6 py-16">
    <h1 class="font-serif text-3xl font-bold tracking-tight">{heading}</h1>
    <p class="text-muted-foreground mt-1 mb-8 text-sm">{subheading}</p>
    <slot />
  </main>
</Layout>
