---
import { ThemeToggle } from "@/components/theme-toggle";
import Layout from "@/layouts/layout.astro";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<Layout title={title}>
  <div class="fixed top-4 right-4 z-50">
    <ThemeToggle client:load />
  </div>
  <main class="mx-auto flex min-h-dvh max-w-sm flex-col justify-center px-6 py-16">
    <a href="/" class="mb-8 inline-flex items-center gap-2" aria-label="absqir home">
      <img src="/favicon.svg" alt="" class="size-7" />
      <span class="font-serif text-xl font-bold tracking-tight">absqir</span>
    </a>
    <slot />
  </main>
</Layout>
