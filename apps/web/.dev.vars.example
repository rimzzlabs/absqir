# Local overrides for `astro dev` and `wrangler dev`. Never commit .dev.vars.
# Production values come from wrangler.jsonc vars and `pnpm cf:secret`.
ENVIRONMENT="development"

BETTER_AUTH_SECRET="replace-me-with-a-32-character-secret-value"

# Optional outside production. Leave it empty and the server prints every
# sign-in code and invitation link to its log instead of sending mail.
RESEND_API_KEY=""

# Lets every account create organizations. Off means only the first account
# and promoted accounts can; joining through an invitation never needs it.
REGISTRATION_OPEN="false"
