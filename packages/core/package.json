{
  "name": "@absqir/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./money": {
      "development": "./src/money.ts",
      "default": "./dist/money.js"
    },
    "./date": {
      "development": "./src/date.ts",
      "default": "./dist/date.js"
    },
    "./query-keys": {
      "development": "./src/query-keys.ts",
      "default": "./dist/query-keys.js"
    },
    "./user-agent": {
      "development": "./src/user-agent.ts",
      "default": "./dist/user-agent.js"
    },
    "./check-in-link": {
      "development": "./src/check-in-link.ts",
      "default": "./dist/check-in-link.js"
    },
    "./notification-channel": {
      "development": "./src/notification-channel.ts",
      "default": "./dist/notification-channel.js"
    },
    "./timezone": {
      "development": "./src/timezone.ts",
      "default": "./dist/timezone.js"
    },
    "./email-domain": {
      "development": "./src/email-domain.ts",
      "default": "./dist/email-domain.js"
    },
    "./attendance-series": {
      "development": "./src/attendance-series.ts",
      "default": "./dist/attendance-series.js"
    }
  },
  "imports": {
    "#src/*": "./src/*.ts"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@mobily/ts-belt": "4.0.0-rc.5",
    "date-fns": "^4.4.0",
    "dinero.js": "^2.0.2",
    "ts-pattern": "^5.9.0"
  },
  "devDependencies": {
    "@absqir/config": "workspace:^",
    "tsdown": "^0.23.0",
    "vitest": "^5.0.0"
  }
}
