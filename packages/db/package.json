{
  "name": "@absqir/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./schema": {
      "development": "./src/schema.ts",
      "default": "./dist/schema.js"
    },
    "./migrate": {
      "development": "./src/migrate.ts",
      "default": "./dist/migrate.js"
    },
    "./ops": {
      "development": "./src/ops.ts",
      "default": "./dist/ops.js"
    },
    "./accounts": {
      "development": "./src/accounts.ts",
      "default": "./dist/accounts.js"
    },
    "./people": {
      "development": "./src/people.ts",
      "default": "./dist/people.js"
    },
    "./domains": {
      "development": "./src/domains.ts",
      "default": "./dist/domains.js"
    }
  },
  "imports": {
    "#src/*": "./src/*.ts"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "generate": "drizzle-kit generate",
    "migrate": "drizzle-kit migrate",
    "push": "drizzle-kit push",
    "studio": "drizzle-kit studio",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@absqir/core": "workspace:^",
    "@mobily/ts-belt": "4.0.0-rc.5",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.23.0",
    "ts-pattern": "^5.9.0"
  },
  "devDependencies": {
    "@absqir/config": "workspace:^",
    "@t3-oss/env-core": "^0.13.11",
    "@types/pg": "^8.23.1",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "tsdown": "^0.23.0",
    "vitest": "^5.0.0",
    "zod": "^4.5.4"
  }
}
