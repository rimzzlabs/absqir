{
  "name": "absqir",
  "version": "0.0.0",
  "description": "Operator CLI for self-hosting absqir, the QR attendance system",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rimzzlabs/absqir.git",
    "directory": "packages/cli"
  },
  "homepage": "https://absqir.rimzzlabs.com",
  "bugs": "https://github.com/rimzzlabs/absqir/issues",
  "type": "module",
  "bin": {
    "absqir": "dist/index.js"
  },
  "imports": {
    "#src/*": "./src/*.ts"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@absqir/config": "workspace:^",
    "@clack/prompts": "1.7.0",
    "@types/node": "^26.5.0",
    "picocolors": "1.1.1",
    "tsdown": "^0.23.0",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@mobily/ts-belt": "4.0.0-rc.5"
  }
}
