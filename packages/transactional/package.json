{
  "name": "@absqir/transactional",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./emails/otp": {
      "development": "./src/emails/otp.tsx",
      "default": "./dist/emails/otp.js"
    },
    "./emails/invitation": {
      "development": "./src/emails/invitation.tsx",
      "default": "./dist/emails/invitation.js"
    },
    "./emails/notification": {
      "development": "./src/emails/notification.tsx",
      "default": "./dist/emails/notification.js"
    }
  },
  "imports": {
    "#src/components/*": "./src/components/*.tsx",
    "#src/emails/*": "./src/emails/*.tsx",
    "#src/*": "./src/*.ts"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "dev:email": "email dev --dir ./src/emails --port 3001",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@mobily/ts-belt": "4.0.0-rc.5",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "resend": "^6.26.0"
  },
  "devDependencies": {
    "@absqir/config": "workspace:^",
    "@react-email/ui": "^6.9.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "react-email": "^6.9.3",
    "tsdown": "^0.23.0"
  }
}
