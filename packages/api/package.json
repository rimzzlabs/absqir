{
  "name": "@absqir/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "imports": {
    "#src/*": "./src/*.ts"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@absqir/auth": "workspace:^",
    "@absqir/core": "workspace:^",
    "@absqir/db": "workspace:^",
    "@absqir/i18n": "workspace:^",
    "@absqir/transactional": "workspace:^",
    "@date-fns/tz": "^1.5.0",
    "@hono/zod-openapi": "^1.6.3",
    "@mobily/ts-belt": "4.0.0-rc.5",
    "@scalar/hono-api-reference": "^0.12.14",
    "@t3-oss/env-core": "^0.13.11",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "ts-pattern": "^5.9.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@absqir/config": "workspace:^",
    "tsdown": "^0.23.1",
    "vitest": "^5.0.5"
  }
}
