{
  "name": "@absqir/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./styles.css": "./src/styles/globals.css",
    "./lib/utils": {
      "development": "./src/lib/utils.ts",
      "default": "./dist/lib/utils.js"
    },
    "./motion-provider": {
      "development": "./src/components/motion-provider.tsx",
      "default": "./dist/components/motion-provider.js"
    },
    "./reveal": {
      "development": "./src/components/reveal.tsx",
      "default": "./dist/components/reveal.js"
    },
    "./hooks/*": {
      "development": "./src/hooks/*.ts",
      "default": "./dist/hooks/*.js"
    },
    "./*": {
      "development": "./src/components/ui/*.tsx",
      "default": "./dist/components/ui/*.js"
    },
    "./form": {
      "development": "./src/components/ui/form.tsx",
      "default": "./dist/components/ui/form.js"
    }
  },
  "imports": {
    "#src/components/*": "./src/components/*.tsx",
    "#src/hooks/*": "./src/hooks/*.ts",
    "#src/lib/*": "./src/lib/*.ts"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@absqir/i18n": "workspace:^",
    "@base-ui/react": "^1.9.0",
    "@hookform/resolvers": "^5.9.1",
    "@mobily/ts-belt": "4.0.0-rc.5",
    "@phosphor-icons/react": "^2.1.10",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "input-otp": "^1.5.0",
    "motion": "^13.2.0",
    "react": "^19.3.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.89.0",
    "recharts": "3.10.1",
    "ts-pattern": "^5.9.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@absqir/config": "workspace:^",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "jsdom": "^30.1.2",
    "shadcn": "^4.21.4",
    "tailwindcss": "^4.3.3",
    "tsdown": "^0.23.0",
    "vitest": "^5.0.3"
  }
}
