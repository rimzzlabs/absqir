{
  "name": "absqir",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@absqir/web",
    "dev:https": "pnpm --filter @absqir/web dev:https",
    "dev:all": "turbo run dev --filter=@absqir/web...",
    "dev:email": "turbo run dev:email --filter=@absqir/transactional",
    "docs:dev": "pnpm --filter @absqir/docs dev",
    "docs:build": "pnpm --filter @absqir/docs build",
    "docs:preview": "pnpm --filter @absqir/docs preview",
    "build": "turbo run build",
    "build:node": "DEPLOY_TARGET=node turbo run build",
    "preview": "pnpm --filter @absqir/web preview",
    "deploy": "turbo run build && pnpm --filter @absqir/web deploy",
    "typecheck": "turbo run typecheck",
    "check": "biome check . && node scripts/check-addresses.mjs",
    "fix": "biome check --write .",
    "format": "prettier --write \"**/*.{md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{md,yml,yaml}\"",
    "cf:types": "pnpm --filter @absqir/web cf-typegen",
    "cf:hyperdrive": "pnpm --filter @absqir/web exec wrangler hyperdrive create absqir-db",
    "cf:secret": "pnpm --filter @absqir/web exec wrangler secret put",
    "db:generate": "pnpm --filter @absqir/db generate",
    "db:migrate": "pnpm --filter @absqir/db migrate",
    "db:push": "pnpm --filter @absqir/db push",
    "db:studio": "pnpm --filter @absqir/db studio",
    "prepare": "lefthook install && git config pull.rebase true && pnpm cf:types",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "test:coverage": "turbo run test -- --coverage",
    "commit": "cz"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "commitizen": "^4.3.2",
    "cz-git": "^1.14.0",
    "lefthook": "^2.2.2",
    "prettier": "^3.9.10",
    "turbo": "^2.11.8",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.1"
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-git"
    }
  },
  "license": "MIT",
  "version": "0.7.0",
  "dependencies": {
    "@mobily/ts-belt": "4.0.0-rc.5",
    "ts-pattern": "^5.9.2"
  }
}
